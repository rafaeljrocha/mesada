# Copie para .env apenas em desenvolvimento local. Em produção, cadastre as
# variáveis no EasyPanel (aba "Ambiente" do serviço). Nunca versione o .env.

# producao | desenvolvimento | teste
APP_ENV=producao

# Gere uma vez e não troque (trocar desconecta todos os aparelhos):
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# URL interna do PostgreSQL criado no EasyPanel.
# Ex.: postgres://mesada:SENHA@mesada_postgres:5432/mesada
DATABASE_URL=

# Volume persistente para imagens enviadas.
DATA_DIR=/data

# 1 quando o domínio estiver com HTTPS válido (cadeado verde).
COOKIES_SEGUROS=1
# 1 atrás do proxy do EasyPanel.
PROXY_FIX=1

# Dias que o aparelho fica conectado à família.
SESSAO_DIAS=30

# 0 = só é possível criar a primeira família. 1 = cadastro aberto a novas famílias.
CADASTRO_ABERTO=0

# Opcionais
UPLOAD_MAX_MB=8
IMAGEM_LADO_MAX=1024
LOGIN_MAX_FALHAS=5
PIN_MAX_FALHAS=5
BLOQUEIO_MINUTOS=15
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
